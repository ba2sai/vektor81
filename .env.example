# =====================================================================
# VEKTOR81 v2 — ON-PREMISE COLLECTOR & HYBRID TUNNEL CONFIGURATION
# Copy to .env and fill all secrets before starting Docker Compose.
# =====================================================================

# Runtime environment: production | development
VEKTOR81_ENV=production

# Mandatory Bearer token required by On-Premise Collector API (generate with: openssl rand -hex 32)
ONPREM_API_TOKEN=CHANGE_ME_GENERATE_32_BYTE_HEX_TOKEN

# Optional development-only token (ignored when VEKTOR81_ENV=production)
ONPREM_DEV_API_TOKEN=

# Comma-separated strict CORS origins (never use * in production)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# Enable explicit POST /api/v1/admin/seed-demo (must remain false in production)
ENABLE_DEMO_TOOLS=false

# Local SQLite WAL persistence
DATABASE_URL=sqlite:///./data/vektor81_collector.db

# Tenant & Panama Regulatory Profile: ANTAI_LEY81 | SBP_001_2022 | SALUD_LEY68
TENANT_ID=default-tenant
REGULATORY_PROFILE=ANTAI_LEY81
COLLECTOR_ID=collector-01

# Cloudflare Control Plane Sync (leave empty for air-gapped local-only mode)
CONTROL_PLANE_URL=https://vektor81-control-plane.example.workers.dev
COLLECTOR_TOKEN=CHANGE_ME_CONTROL_PLANE_COLLECTOR_TOKEN

# Cloudflare Zero Trust Tunnel (outbound-only)
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARED_TUNNEL_TOKEN
CLOUDFLARED_METRICS_URL=http://cloudflared:2000/ready

# AdGuard Home Local DNS Connector
ADGUARD_URL=http://adguard:3000
ADGUARD_USER=admin
ADGUARD_PASS=CHANGE_ME_ADGUARD_PASSWORD

# Optional Wazuh FIM REST API Connector (leave WAZUH_API_URL blank if unused)
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASS=
WAZUH_VERIFY_TLS=true
